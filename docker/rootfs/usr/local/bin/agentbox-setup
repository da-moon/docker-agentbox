#!/usr/bin/env bash
# Runs once at container start as an s6-rc oneshot, after the nix-daemon
# longrun is up. Failing here stops the container
# (S6_BEHAVIOUR_IF_STAGE2_FAILS=2).
set -euo pipefail

readonly AGENT_USER="agent"
readonly AGENT_HOME="/home/${AGENT_USER}"
readonly WORKSPACE="/workspace"
readonly DAEMON_SOCKET="${NIX_DAEMON_SOCKET_PATH:-/run/nix-daemon/socket}"

requested_uid="${AGENT_UID:-1000}"
requested_gid="${AGENT_GID:-1000}"

is_unsigned_integer() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

if ! is_unsigned_integer "$requested_uid" || ! is_unsigned_integer "$requested_gid"; then
  echo "AGENT_UID and AGENT_GID must be non-negative integers." >&2
  exit 2
fi

if [ "$requested_uid" = "0" ] || [ "$requested_gid" = "0" ]; then
  echo "The container always runs unprivileged; AGENT_UID and AGENT_GID must be non-zero." >&2
  exit 2
fi

current_uid="$(id -u "$AGENT_USER")"
current_gid="$(id -g "$AGENT_USER")"

if [ "$current_gid" != "$requested_gid" ]; then
  groupmod --non-unique --gid "$requested_gid" "$AGENT_USER"
fi

if [ "$current_uid" != "$requested_uid" ]; then
  usermod --non-unique --uid "$requested_uid" --gid "$requested_gid" "$AGENT_USER"
elif [ "$current_gid" != "$requested_gid" ]; then
  usermod --gid "$requested_gid" "$AGENT_USER"
fi

mkdir -p "$AGENT_HOME" "$WORKSPACE"
chown "$requested_uid:$requested_gid" "$AGENT_HOME" "$WORKSPACE"

# The nix-daemon longrun is supervised by s6 and restarted on failure, so the
# socket appears unless the daemon is hopelessly broken.
for _ in $(seq 1 100); do
  if [ -S "$DAEMON_SOCKET" ]; then
    break
  fi
  sleep 0.05
done

if [ ! -S "$DAEMON_SOCKET" ]; then
  echo "Timed out waiting for nix-daemon socket at ${DAEMON_SOCKET}." >&2
  exit 1
fi

# The base profile (harness shims, the agentbox CLI, boot tools) lives on the
# /nix volume, so a volume created by an older image keeps that image's
# profile: shims for harnesses added later are missing even though the current
# image carries them. The image bakes the expected harness command names into
# /opt/agentbox/harness-commands (never shadowed by the volume); refresh the
# base profile from the image flake when it disagrees with the volume's
# profile. Best-effort: a failure (e.g. no network) leaves the old profile.
refresh_base_profile() {
  local profile="/nix/var/nix/profiles/agentbox"
  local commands="/opt/agentbox/harness-commands"
  local cmd missing=""
  [ -e "$commands" ] || return 0
  while IFS= read -r cmd; do
    if [ -n "$cmd" ] && [ ! -e "$profile/bin/$cmd" ]; then
      missing="$missing $cmd"
    fi
  done < "$commands"
  [ -e "$profile/bin/agentbox" ] || missing="$missing agentbox"
  [ -n "$missing" ] || return 0
  echo "agentbox: refreshing the base profile (missing:${missing})..."
  # root owns /root; the agent home belongs to the unprivileged user.
  #
  # Realise the new base before touching the profile, so a failure (e.g. no
  # network) leaves the existing profile untouched. nix profile add matches
  # elements by their original flake URL, not by name, so a base baked by an
  # older image (path:/tmp/agentbox-build) is not replaced by one from
  # path:/opt/agentbox - it conflicts on overlapping files instead. Remove
  # the stale element (matched by name) before adding the current one. After
  # a successful build the add is store-local and cannot lose the profile to
  # a network error.
  if ! HOME=/root nix build --no-link --no-write-lock-file "path:/opt/agentbox#agentbox-base"; then
    echo "agentbox: could not build the current base profile; keeping the existing one" >&2
    return 0
  fi
  HOME=/root nix profile remove --profile "$profile" agentbox-base 2>/dev/null || true
  if HOME=/root nix profile add \
    --profile "$profile" \
    --no-write-lock-file \
    "path:/opt/agentbox#agentbox-base"; then
    echo "agentbox: base profile refreshed"
  else
    echo "agentbox: base profile refresh failed; continuing with the existing profile" >&2
  fi
}

refresh_base_profile

# Home Manager owns the per-user environment: the startup packages and the
# seeded harness defaults, defined by the flake template in
# /opt/agentbox/home-flake. The template files are copied to
# ~/.config/home-manager on first start so the user owns them and can evolve
# them with plain `hm-switch` or `home-manager switch`.
apply_home_manager() {
  case "$(uname -m)" in
  x86_64) hm_system="x86_64-linux" ;;
  aarch64) hm_system="aarch64-linux" ;;
  *)
    echo "agentbox: unsupported architecture for home-manager (skipping)" >&2
    return 0
    ;;
  esac
  flake_ref="$AGENT_HOME/.config/home-manager#agent"
  # AGENTBOX_SYSTEM expands in the inner sh, not here.
  # shellcheck disable=SC2016
  su-exec "$1" env HOME="$AGENT_HOME" AGENTBOX_SYSTEM="$hm_system" sh -c '
    [ -e "$HOME/.config/home-manager/flake.nix" ] && exit 0
    mkdir -p "$HOME/.config/home-manager"
    install -m 0644 /opt/agentbox/home-flake/flake.lock "$HOME/.config/home-manager/flake.lock"
    cp -R /opt/agentbox/home-flake/programs "$HOME/.config/home-manager/programs"
    sed "s/@AGENTBOX_SYSTEM@/$AGENTBOX_SYSTEM/" /opt/agentbox/home-flake/flake.nix \
      >"$HOME/.config/home-manager/flake.nix"
  ' || echo "agentbox: home-manager template install failed (continuing)" >&2

  su-exec "$1" env HOME="$AGENT_HOME" USER="$AGENT_USER" NIX_REMOTE=daemon \
    home-manager switch -b backup --flake "$flake_ref" ||
    echo "agentbox: home-manager switch failed (continuing)" >&2
}

# The agentbox overlay flake mirrors the Home Manager template: the immutable
# image copy at /opt/agentbox is cloned to ~/.config/agentbox on first start so
# the agent owns the harness version pins and can evolve them with the
# `agentbox` command. Copied only when absent; delete it to restore the image
# defaults on the next start.
seed_agentbox_overlay() {
  # $HOME expands in the inner sh, not here.
  # shellcheck disable=SC2016
  su-exec "$1" env HOME="$AGENT_HOME" sh -c '
    dest="$HOME/.config/agentbox"
    [ -e "$dest/flake.nix" ] && exit 0
    mkdir -p "$HOME/.config"
    cp -R /opt/agentbox "$dest"
  ' || echo "agentbox: overlay template install failed (continuing)" >&2
}

export HOME="$AGENT_HOME"
export USER="$AGENT_USER"
export LOGNAME="$AGENT_USER"
seed_agentbox_overlay "${requested_uid}:${requested_gid}"
apply_home_manager "${requested_uid}:${requested_gid}"
